rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // بيانات المستخدمات: كل مستخدمة تقرأ بياناتها فقط
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // لا تعديل من التطبيق، فقط يدويًا من Firebase Console
    }

    // التقارير: أي شخص مسجل دخول فقط يقدر يقرأ/يكتب (يشمل الحفظ والإرسال والاعتماد)
    match /reports/{reportId} {
      allow read, write: if request.auth != null;
    }
  }
}
